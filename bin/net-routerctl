#!/usr/bin/env python3
import json, socket, sys
SOCK="/run/net-router/router.sock"

def req(payload):
    s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
    s.settimeout(20)
    s.connect(SOCK)
    s.sendall((json.dumps(payload)+"\n").encode())
    out=b""
    while True:
        c=s.recv(65536)
        if not c: break
        out+=c
    s.close()
    d=json.loads(out.decode())
    print(json.dumps(d))
    raise SystemExit(0 if d.get("ok") else 1)

if len(sys.argv)<2:
    print('{"ok":false,"error":"usage: net-routerctl status|switch wan1|switch wan2|rebuild"}')
    raise SystemExit(2)

if sys.argv[1]=="status":
    req({"action":"status"})
elif sys.argv[1]=="rebuild":
    req({"action":"rebuild"})
elif sys.argv[1]=="switch" and len(sys.argv)==3 and sys.argv[2] in ("wan1","wan2"):
    req({"action":"switch","wan":sys.argv[2]})
else:
    print('{"ok":false,"error":"invalid command"}')
    raise SystemExit(2)
