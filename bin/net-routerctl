#!/usr/bin/env python3
import json
import socket
import sys

SOCK = "/run/net-router/router.sock"

def request(payload):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(30)
    s.connect(SOCK)
    s.sendall((json.dumps(payload) + "\n").encode())
    out = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        out += chunk
    s.close()
    data = json.loads(out.decode())
    if not data.get("ok"):
        print(json.dumps(data))
        sys.exit(1)
    print(json.dumps(data))

if len(sys.argv) < 2:
    print(json.dumps({"ok": False, "error": "usage: net-routerctl status|interfaces|switch <wan1|wan2>|apply <json>"}))
    sys.exit(2)

cmd = sys.argv[1]

if cmd == "status":
    request({"action": "status"})
elif cmd == "interfaces":
    request({"action": "interfaces"})
elif cmd == "switch" and len(sys.argv) == 3 and sys.argv[2] in ("wan1", "wan2"):
    request({"action": "switch", "wan": sys.argv[2]})
elif cmd == "apply" and len(sys.argv) == 3:
    request({"action": "apply_network_manual", "config": json.loads(sys.argv[2])})
else:
    print(json.dumps({"ok": False, "error": "invalid command"}))
    sys.exit(2)
