#!/usr/bin/env python3
import json, socket, sys
SOCK="/run/net-router/router.sock"

def req(payload):
    s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
    s.settimeout(20)
    s.connect(SOCK)
    s.sendall((json.dumps(payload)+"\n").encode())
    out=b""
    while True:
        c=s.recv(65536)
        if not c: break
        out+=c
    s.close()
    d=json.loads(out.decode())
    print(json.dumps(d))
    raise SystemExit(0 if d.get("ok") else 1)

if len(sys.argv)<2:
    print('{"ok":false,"error":"usage: net-routerctl status|switch wan1|switch wan2|mapping-add LAN_IP DECO_IP VODAFONE_IP [LABEL]|mapping-del LAN_IP"}')
    raise SystemExit(2)

cmd=sys.argv[1]
if cmd=="status":
    req({"action":"status"})
elif cmd=="switch" and len(sys.argv)==3 and sys.argv[2] in ("wan1","wan2"):
    req({"action":"switch","wan":sys.argv[2]})
elif cmd=="mapping-add" and len(sys.argv)>=5:
    req({"action":"mapping_add","lan_ip":sys.argv[2],"wan1_ip":sys.argv[3],"wan2_ip":sys.argv[4],"label":" ".join(sys.argv[5:])})
elif cmd=="mapping-del" and len(sys.argv)==3:
    req({"action":"mapping_delete","lan_ip":sys.argv[2]})
elif cmd=="mapping-apply":
    req({"action":"mapping_apply"})
else:
    print('{"ok":false,"error":"invalid command"}')
    raise SystemExit(2)
